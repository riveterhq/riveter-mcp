{
  "name": "riveter-mcp-server",
  "version": "0.3.6",
  "mcpName": "io.github.CodyWatters/riveter",
  "description": "MCP server for the Riveter API — connects Claude to Riveter's enrichment, scraping, and monitoring tools",
  "homepage": "https://docs.riveterhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riveterhq/riveter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/riveterhq/riveter-mcp/issues",
    "email": "support@riveterhq.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "riveter-mcp-server": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:http": "tsx watch src/http.ts",
    "dev:http:local": "RIVETER_OPENAPI_URL=http://localhost:3000/api_docs/openapi.yaml RIVETER_API_BASE_URL=http://localhost:3000/v1 MCP_PUBLIC_URL=http://localhost:8080/mcp tsx watch src/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.7.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "riveter",
    "claude",
    "ai",
    "enrichment",
    "api",
    "mcp-server",
    "model-context-protocol",
    "data-enrichment",
    "web-scraping"
  ],
  "license": "MIT"
}
